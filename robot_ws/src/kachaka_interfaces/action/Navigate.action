# Goal: The destination coordinates
float64 target_x
float64 target_y
# Final heading in radians, expressed in the same frame as target_x and target_y.
float64 target_theta
# When false, the navigation server derives a heading that faces the destination.
bool has_target_theta
---
# Result: Final status after the action completes
bool success
string message
---
# Feedback: Periodic updates while the robot is moving
float64 current_x
float64 current_y
float64 distance_remaining
